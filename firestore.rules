rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connectivity test - allow all access to test path
    match /test/{any=**} {
      allow read, write: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (data.completedLessons is list || !data.keys().hasAll(['completedLessons'])) &&
             (data.quizResults is list || !data.keys().hasAll(['quizResults'])) &&
             (data.favoriteQuestions is list || !data.keys().hasAll(['favoriteQuestions'])) &&
             (data.totalTimeSpent is number || !data.keys().hasAll(['totalTimeSpent'])) &&
             (data.lastActive is string || !data.keys().hasAll(['lastActive']));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Friend Challenge rooms and participants
    match /challenges/{challengeId} {
      allow read: if true;
      allow create, update: if true;

      match /participants/{participantId} {
        allow read: if true;
        allow create, update: if true;
      }
    }

    // Question Reports submitted by students
    function isValidQuestionReport(data) {
      return data.studentReport is string && 
             data.studentReport.size() > 0 && 
             data.studentReport.size() <= 5000 &&
             data.status == 'new' &&
             data.createdAt == request.time &&
             (data.questionText is string || !data.keys().hasAll(['questionText'])) &&
             (data.subject is string || !data.keys().hasAll(['subject'])) &&
             (data.unitTitle is string || !data.keys().hasAll(['unitTitle'])) &&
             (data.examTitle is string || !data.keys().hasAll(['examTitle'])) &&
             (data.questionNumber is number || !data.keys().hasAll(['questionNumber'])) &&
             (data.choices is list || !data.keys().hasAll(['choices'])) &&
             (data.correctAnswer is string || !data.keys().hasAll(['correctAnswer'])) &&
             (data.explanation is string || !data.keys().hasAll(['explanation'])) &&
             (data.studentEmail is string || !data.keys().hasAll(['studentEmail'])) &&
             (data.studentUid is string || !data.keys().hasAll(['studentUid']));
    }

    match /questionReports/{reportId} {
      allow read, update, delete: if false;
      allow create: if isValidId(reportId) && isValidQuestionReport(request.resource.data);
    }

    // ========================================================
    // FORUM RULES (منتدى الطلاب JoSchool11)
    // ========================================================

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'mechail.sbeatan1@gmail.com';
    }

    function isValidForumPost(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 3000 &&
             data.likesCount is number && data.likesCount >= 0 &&
             data.commentsCount is number && data.commentsCount >= 0 &&
             (data.imageUrl is string || !data.keys().hasAll(['imageUrl'])) &&
             (data.userPhoto is string || !data.keys().hasAll(['userPhoto'])) &&
             (data.userEmail is string || !data.keys().hasAll(['userEmail']));
    }

    function isValidForumComment(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
             (data.userPhoto is string || !data.keys().hasAll(['userPhoto']));
    }

    match /posts/{postId} {
      // Anyone can read posts
      allow read: if true;
      // Registered users can create posts with their own UID
      allow create: if isSignedIn() && isValidForumPost(request.resource.data);
      // Only the author or admin can delete a post
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      // Updates allowed for likesCount & commentsCount increments
      allow update: if isSignedIn();

      // Likes subcollection (key = userId so user can only like once)
      match /likes/{userId} {
        allow read: if true;
        allow create, delete: if isSignedIn() && request.auth.uid == userId;
      }

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidForumComment(request.resource.data);
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      }
    }

    // Forum Reports submitted by users
    function isValidReport(data) {
      return data.reporterId is string && data.reporterId == request.auth.uid &&
             data.targetType in ['post', 'comment'] &&
             data.reason is string && data.reason.size() > 0 &&
             data.status == 'pending';
    }

    match /reports/{reportId} {
      // Any signed in user can submit a report
      allow create: if isSignedIn() && isValidReport(request.resource.data);
      // Only admin can read, review, or delete reports
      allow read, update, delete: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
