{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and progress data.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "completedLessons": { "type": "array", "items": { "type": "string" } },
        "quizResults": { "type": "array", "items": { "$ref": "#/entities/QuizResult" } },
        "favoriteQuestions": { "type": "array", "items": { "type": "object" } },
        "totalTimeSpent": { "type": "number" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "QuizResult": {
      "title": "QuizResult",
      "description": "Data for a completed quiz.",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string" },
        "lessonTitle": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      }
    },
    "Challenge": {
      "title": "Challenge",
      "description": "A shared quiz challenge between friends.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "lessonTitle": { "type": "string" },
        "totalQuestions": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string" }
      },
      "required": ["id", "code", "creatorName", "subjectId", "lessonTitle"]
    },
    "ChallengeParticipant": {
      "title": "ChallengeParticipant",
      "description": "Participant in a friend challenge.",
      "type": "object",
      "properties": {
        "participantId": { "type": "string" },
        "name": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "timeSpent": { "type": "number" },
        "status": { "type": "string" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participantId", "name", "status"]
    },
    "QuestionReport": {
      "title": "QuestionReport",
      "description": "Student report for an error in a question.",
      "type": "object",
      "properties": {
        "subject": { "type": "string" },
        "unitTitle": { "type": "string" },
        "examTitle": { "type": "string" },
        "questionNumber": { "type": "number" },
        "questionText": { "type": "string" },
        "choices": { "type": "array", "items": { "type": "string" } },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "studentReport": { "type": "string" },
        "studentEmail": { "type": "string" },
        "studentUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["new", "reviewed", "resolved", "dismissed"] }
      },
      "required": ["questionText", "studentReport", "status"]
    },
    "ForumPost": {
      "title": "ForumPost",
      "description": "A post in the student community forum.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "userEmail": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "isEdited": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "text"]
    },
    "ForumComment": {
      "title": "ForumComment",
      "description": "A comment on a forum post.",
      "type": "object",
      "properties": {
        "commentId": { "type": "string" },
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "userId", "userName", "text"]
    },
    "ForumLike": {
      "title": "ForumLike",
      "description": "A like on a forum post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId"]
    },
    "ForumReport": {
      "title": "ForumReport",
      "description": "A report regarding objectionable forum post or comment.",
      "type": "object",
      "properties": {
        "reportId": { "type": "string" },
        "reporterId": { "type": "string" },
        "reporterName": { "type": "string" },
        "targetType": { "type": "string", "enum": ["post", "comment"] },
        "targetId": { "type": "string" },
        "postId": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved", "dismissed"] }
      },
      "required": ["reporterId", "targetType", "targetId", "reason", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and progress."
    },
    "/test/connection": {
      "schema": { "type": "object", "properties": {} },
      "description": "Used for testing the Firestore connection on app boot."
    },
    "/challenges/{challengeId}": {
      "schema": "Challenge",
      "description": "Friend challenge room."
    },
    "/challenges/{challengeId}/participants/{participantId}": {
      "schema": "ChallengeParticipant",
      "description": "Participant results and status in a challenge."
    },
    "/questionReports/{reportId}": {
      "schema": "QuestionReport",
      "description": "Reports submitted by students about question errors."
    },
    "/posts/{postId}": {
      "schema": "ForumPost",
      "description": "Community forum posts."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "ForumComment",
      "description": "Comments on a forum post."
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": "ForumLike",
      "description": "Likes on a forum post indexed by user ID."
    },
    "/reports/{reportId}": {
      "schema": "ForumReport",
      "description": "Reports on forum posts or comments."
    }
  }
}
